  "info": {
    "title": "Hearthline local model API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "readHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful operation"
          }
        },
        "summary": "Read API and model health"
      }
    },
    "/api/model": {
      "get": {
        "operationId": "readModel",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelSummary"
                }
              }
            },
            "description": "Successful operation"
          }
        },
        "summary": "Read immutable model revision"
      }
    },
    "/api/model/documents": {
      "get": {
        "operationId": "readModelDocuments",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelDocumentCatalog"
                }
              }
            },
            "description": "Successful operation"
          }
        },
        "summary": "Read locked editable model documents"
      }
    },
    "/api/model/drafts": {
      "post": {
        "operationId": "createModelDraft",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCreated"
                }
              }
            },
            "description": "Successful operation"
          }
        },
        "summary": "Create revisioned model draft"
      }
    },
    "/api/model/drafts/{id}": {
      "delete": {
        "operationId": "discardModelDraft",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful operation"
          }
        },
        "summary": "Discard a model draft"
      }
    },
    "/api/model/drafts/{id}/commit": {
      "post": {
        "operationId": "commitModelDraft",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftCommitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCommitResponse"
                }
              }
            },
            "description": "Successful operation"
          }
        },
        "summary": "Atomically commit validated draft"
      }
    },
    "/api/model/drafts/{id}/documents": {
      "put": {
        "operationId": "updateModelDraft",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
