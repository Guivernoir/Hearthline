{
  "$defs": {
    "CapacityAssessment": {
      "additionalProperties": false,
      "properties": {
        "demand": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "evidence": {
          "$ref": "#/$defs/CapacityEvidenceRecord"
        },
        "overflow": {
          "type": "string"
        },
        "reservePercent": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "resource": {
          "$ref": "#/$defs/CapacityResource"
        },
        "reviewedLimit": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "scope": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CapacityStatus"
        },
        "structuralLimit": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "resource",
        "scope",
        "demand",
        "reviewedLimit",
        "reservePercent",
        "overflow",
        "status",
        "evidence"
      ],
      "type": "object"
    },
    "CapacityDelta": {
      "additionalProperties": false,
      "properties": {
        "candidateDemand": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "candidateStatus": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapacityStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "previousDemand": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "resource": {
          "$ref": "#/$defs/CapacityResource"
        },
        "scope": {
          "type": "string"
        }
      },
      "required": [
        "resource",
        "scope"
      ],
      "type": "object"
    },
    "CapacityEvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "detail"
      ],
      "type": "object"
    },
    "CapacityPlan": {
      "additionalProperties": false,
      "properties": {
        "assessments": {
          "items": {
            "$ref": "#/$defs/CapacityAssessment"
          },
          "type": "array"
        }
      },
      "required": [
        "assessments"
      ],
      "type": "object"
    },
    "CapacityResource": {
      "enum": [
        "process-ports",
        "process-tags",
        "hmi-command-tags",
        "appliance-ports",
        "switch-ports",
        "layer3-switch-ports",
        "unaddressed-ports",
        "cell-components",
        "cell-links",
        "site-cells",
        "inter-cell-conduits",
        "conduit-queue",
        "scheduled-events",
        "runtime-object-bytes",
        "runtime-memory-bytes",
        "runtime-stack-bytes"
      ],
      "type": "string"
    },
    "CapacityStatus": {
      "enum": [
        "accepted",
        "review-required",
        "rejected"
      ],
      "type": "string"
    },
    "DraftDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "type": "string"
        }
      },
      "required": [
        "severity",
        "message"
      ],
      "type": "object"
    },
    "SourceDigest": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "addedObjects": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "affectedScenarios": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "baseRevision": {
      "type": "string"
    },
    "candidateRevision": {
      "type": [
        "string",
        "null"
      ]
    },
    "capacity": {
      "anyOf": [
        {
          "$ref": "#/$defs/CapacityPlan"
        },
        {
          "type": "null"
        }
      ]
    },
    "capacityDeltas": {
      "items": {
        "$ref": "#/$defs/CapacityDelta"
      },
      "type": "array"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/DraftDiagnostic"
      },
      "type": "array"
    },
    "draft": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "modifiedObjects": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "previewCatalogs": {
      "items": {
        "$ref": "#/$defs/SourceDigest"
      },
      "type": "array"
    },
    "removedObjects": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "draft",
    "baseRevision",
    "diagnostics",
    "addedObjects",
    "removedObjects",
    "modifiedObjects",
    "capacityDeltas",
    "affectedScenarios",
    "previewCatalogs"
  ],
  "title": "DraftPreview",
  "type": "object"
}
