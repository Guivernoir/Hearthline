{
  "name": "hearthline-architecture",
  "private": true,
  "version": "0.3.2",
  "engines": {
    "node": "26.8.1",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview --host 0.0.0.0",
    "version:check": "node ../../project/scripts/check-version.mjs",
    "test": "vitest run --coverage && node ../../project/scripts/check-web-coverage.mjs artifacts/coverage/web/coverage-summary.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/svelte": "1.27.0",
    "svelte": "5.56.8",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@testing-library/svelte": "5.2.8",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "svelte-check": "4.7.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  }
}
