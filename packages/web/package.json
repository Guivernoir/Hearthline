{
  "name": "hearthline-architecture",
  "private": true,
  "version": "0.3.3",
  "engines": {
    "node": "26.13.1",
    "npm": "12.2.3"
  },
  "packageManager": "npm@12.2.3",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview --host 0.0.0.0",
    "version:check": "node ../../project/scripts/check-version.mjs",
    "test": "vitest run --coverage && node ../../project/scripts/check-web-coverage.mjs artifacts/coverage/web/coverage-summary.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/svelte": "1.82.0",
    "svelte": "5.59.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.4.1",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.11",
    "@vitest/coverage-v8": "5.1.2",
    "jsdom": "31.0.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
